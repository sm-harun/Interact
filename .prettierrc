{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"tailwindAttributes": ["myClassList"],
	"tailwindConfig": "./tailwind.config.ts",
	"overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
